{
  "ltex.language": "fr",
  "ltex.dictionary": {
    "fr": [":dictionnaire-izmir.txt"]
  },
  "ltex.enabled": ["markdown", "html", "nunjucks"],
  "files.associations": {
    "*.njk": "html"
  },
  "ltex.disabledRules": {
    "fr": ["FRENCH_WHITESPACE"]
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/_site/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/_site": true
  },
  "files.exclude": {
    "**/_site": true
  },
  "json.schemaDownload.enable": false,
  "npm.autoDetect": "off"
}