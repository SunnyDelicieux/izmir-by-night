---
titre: Galerie
layout: base.njk
css: [/css/izmir.css, /galerie/galerie.css]
---
{#- La galerie. Les dessins : src/_data/galerie.yaml. Les boutons de filtre : src/_data/galerie_filtres.yaml. -#}
<div class="page-wrap">
    <aside class="sidebar">

        <div class="now">
            <div class="title">— thème —</div>
            <div class="filter-group">
            {%- for tag, texte in galerie_filtres.themes %}
                <button class="tag-btn" data-tag="{{ tag }}">{{ texte }}</button>
            {%- endfor %}
            </div>
        </div>

        <div class="now">
            <div class="title">— clan —</div>
            <div class="filter-group">
            {%- for tag, clan in galerie_filtres.clans %}
                <button class="tag-btn" data-tag="{{ tag }}">{{ clan.texte }}</button>
            {%- endfor %}
            </div>
        </div>

        <div class="now">
            <div class="title">— auteur —</div>
            <div class="filter-group">
            {%- for tag, texte in galerie_filtres.auteurs %}
                <button class="tag-btn" data-tag="{{ tag }}">{{ texte }}</button>
            {%- endfor %}
            </div>
        </div>

        <button id="reset-btn">Tout afficher</button>
    </aside>

    <main class="container">

        <div class="box">
<div class="title" id="gallery-title">Galerie</div>
<div id="character-filters"></div>
            <div id="gallery"></div>

            <div id="gallery-pagination" class="gallery-pagination" aria-label="Pagination de la galerie">
                <button id="gallery-prev" type="button">← Précédent</button>
                <div id="gallery-page-list" class="gallery-page-list"></div>
                <button id="gallery-next" type="button">Suivant →</button>
            </div>
        </div>
    </main>
</div>

<div id="zoom">
    <div class="zoom-media">
        <img id="zoom-img" alt="">
        <video id="zoom-video" controls playsinline hidden></video>
        <div class="zoom-nav">
            <button id="zoom-prev" aria-label="Image précédente">←</button>
            <span id="zoom-counter"></span>
            <button id="zoom-next" aria-label="Image suivante">→</button>
        </div>
        <div id="zoom-tags"></div>
        <div id="zoom-desc"></div>
        <a id="zoom-original" target="_blank" rel="noopener">original</a>
    </div>
</div>

<script>window.GALERIE = { dessins: {{ galerie | json | safe }}, clans: {{ galerie_filtres.clans | json | safe }} };</script>
<script src="/galerie/galerie.js"></script>
