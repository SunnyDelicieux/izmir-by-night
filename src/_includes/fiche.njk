---
layout: base.njk
css: [/css/fiche.css]
js: [/js/costumes.js]
---
{#- La fiche d'un personnage. Les infos viennent de l'en-tête du fichier dans src/personnages/ :
      nom, icone, portrait, halloween (portrait du thème Halloween), citation,
      bio: les lignes du tableau, dans l'ordre (ex. Clan: Ventrue),
      tag_galerie: son tag dans la galerie, s'il n'est pas le nom du fichier (ex. enry pour henri.html) -#}
<main>
  <h2 class="character-name">{% if icone %}<img src="{{ icone }}" class="icon" alt="">{% endif %}{{ nom | safe }}</h2>
{%- if portrait or bio %}
  <aside class="bio">
  {%- if portrait %}
    <img src="{{ portrait }}" alt="{{ nom }}"{% if halloween %} data-halloween="{{ halloween }}"{% endif %}>
  {%- endif %}
  {%- if bio %}
    <table>
    {%- for cle, valeur in bio %}
      <tr>
        <td>{{ cle }}</td>
        <td>{{ valeur | safe }}</td>
      </tr>
    {%- endfor %}
    </table>
  {%- endif %}
  </aside>
{%- endif %}
{%- if citation %}
  <section id="info">
    <p class="quote">{{ citation | safe }}</p>
  </section>
{%- endif %}
{{ content | safe }}
{#- Les dessins de la galerie tagués avec le nom du personnage, ajoutés tout seuls. -#}
{%- set onglets = galerie | dessinsDe(tag_galerie or page.fileSlug) %}
{%- if onglets.length %}
  <section id="galerie">
    <h3 class="orange">Galerie</h3>
    <div class="gallery-grid" style="--pages:{{ onglets.length }};">
    {%- for onglet in onglets %}
      <details class="gallery-page" name="galerie-auto" style="--n:{{ loop.index }};"{% if loop.first %} open{% endif %}>
        <summary>{{ onglet.titre }} ({{ onglet.dessins.length }})</summary>
        <div class="img-gallery">
        {%- for dessin in onglet.dessins %}
          <a href="{{ dessin.image }}" target="_blank" rel="noopener">
            <figure>
              <img src="{{ dessin.miniature }}" alt="{{ dessin.alt }}" loading="lazy">
              {%- if dessin.legende %}
              <figcaption>{{ dessin.legende }}</figcaption>
              {%- endif %}
            </figure>
          </a>
        {%- endfor %}
        </div>
      </details>
    {%- endfor %}
    </div>
  </section>
{%- endif %}
</main>
